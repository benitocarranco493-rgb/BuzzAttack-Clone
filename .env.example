# Configuración de la app (ver README)
# Puerto de escucha del servidor (HTTP + WebSocket)
PORT=3000
# Host donde escucha el servidor (0.0.0.0 para red local)
HOST=0.0.0.0
# Orígenes CORS permitidos separados por coma (p. ej. https://<proyecto>.vercel.app
# si la web está en Vercel y el servidor de juego corre aparte). Vacío = solo mismo origen.
CORS_ORIGIN=
# URL pública base usada para generar el QR de la sala (vacío = autodetección de IP local)
PUBLIC_BASE_URL=
# Idioma por defecto de la interfaz y el contenido
DEFAULT_LANG=es
# Habilitar el modo "gamberro" (opt-in +18)
ENABLE_ROWDY=false

# Solo servidor: generación de preguntas con la API de Claude (opcional)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=